{
  "require": {
    "php": "^8.2",
    "ext-dom": "*",
    "ext-zlib": "*"
  },
  "require-dev": {
    "pestphp/pest": "^3.8|^4.7",
    "mockery/mockery": "dev-bugfix/spy-generics",
    "phing/phing": "^3.0",
    "rector/rector": "^2.5",
    "symfony/http-foundation": "^7.4|^8.1"
  },
  "autoload": {
    "psr-4": {
      "Bugo\\Optimus\\": "src\\Sources\\Optimus"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "alpha",
  "scripts": {
    "check": "vendor/bin/rector process --dry-run --clear-cache",
    "test": "vendor/bin/pest --colors=always",
    "test-coverage": "vendor/bin/pest --colors=always --coverage --min=98",
    "test-coverage-clover": "vendor/bin/pest --colors=always --min=98 --coverage-clover coverage.xml",
    "test-coverage-html": "vendor/bin/pest --colors=always --min=98 --coverage-html coverage",
    "post-update-cmd": "cd src/Sources/Optimus && composer update --no-dev -o",
    "build": [
      "composer update",
      "vendor/bin/phing"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
